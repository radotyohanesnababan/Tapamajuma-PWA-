{
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://tapamajuma.smpn1siborongborong.sch.id/$1",
      "permanent": true,
      "has": [
        { "type": "host", "value": "tapamajuma.my.id" }
      ]
    },
    {
      "source": "/(.*)",
      "destination": "https://tapamajuma.smpn1siborongborong.sch.id/$1",
      "permanent": true,
      "has": [
        { "type": "host", "value": "tapamajuma.vercel.app" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}