{
  "redirects": [
    {
      "source": "/:path*",
      "destination": "https://tapamajuma.smpn1siborongborong.sch.id/:path*",
      "permanent": true,
      "has": [
        { "type": "host", "value": "tapamajuma.my.id" }
      ]
    },
    {
      "source": "/:path*",
      "destination": "https://tapamajuma.smpn1siborongborong.sch.id/:path*",
      "permanent": true,
      "has": [
        { "type": "host", "value": "tapamajuma-pwa.vercel.app" }
      ]
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/workbox-(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/specialchangelog/(.*)",
      "destination": "/specialchangelog/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}